def alpha_rect(frame, x1, y1, x2, y2, a):
    overlay = frame.copy()
    cv2.rectangle(overlay, (x1, y1), (x2, y2), (0,0,0), -1)
    cv2.addWeighted(overlay, a, frame, 1-a, 0, frame)

def draw_topbar(frame, state_text):
    h, w = frame.shape[:2]
    alpha_rect(frame, 0, 0, w, 90, 0.55)
    cv2.putText(frame, state_text, (20, 60),
                cv2.FONT_HERSHEY_SIMPLEX, 1.6, (255,255,255), 3, cv2.LINE_AA)

def draw_features_panel(frame, features):
    if features is None:
        return
    h, w = frame.shape[:2]
    x, y = 20, h - 240
    x2, y2 = x + 560, y + 215
    alpha_rect(frame, x, y, x2, y2, 0.55)

    cv2.putText(frame, "5-sec Features", (x + 15, y + 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.8, (210,210,210), 2, cv2.LINE_AA)

    line_y = y + 60
    gap = 24
    keys = list(features.keys())
    for i, k in enumerate(keys[:8]):
        v = features[k]
        txt = f"{k}: {v:.3f}" if isinstance(v, float) else f"{k}: {v}"
        cv2.putText(frame, txt, (x + 15, line_y + i * gap),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255,255,255), 2, cv2.LINE_AA)

