# ======================
# Main
# ======================
def main():
    agg = EventAgg()

    # 키/마우스 수집
    def on_key_press(k):
        try:
            agg.add("key")
        except Exception:
            pass

    keyboard.Listener(on_press=on_key_press).start()
    mouse.Listener(
        on_click=lambda x, y, b, p: agg.add("click") if p else None,
        on_scroll=lambda x, y, dx, dy: agg.add("scroll")
    ).start()

    cap = cv2.VideoCapture(0)

    cv2.namedWindow(WINDOW_NAME, cv2.WINDOW_NORMAL)
    cv2.resizeWindow(WINDOW_NAME, 960, 540)

    vis_buf = deque()      # (now, dict) 5초
    vis_buf30 = deque()    # 30초 누적 이벤트 보기(시연용)

    # 누적 카운트
    unconscious_event_count = 0
    conscious_event_windows = 0
    last_intervention_time = 0.0

    # 팝업/선택
    current_reco = None
    selected_plan_msg = None
    selected_plan_until = 0.0

    # 의식 이탈 배너
    conscious_notice_until = 0.0

    # 데모용 "강의 화면 활성" 토글 (실제 OS 최소화 대신)
    lecture_active = True

    latest_features = None
    last_tick = time.time()

    with mp_face_mesh.FaceMesh(refine_landmarks=True, max_num_faces=1) as fm:
        while True:
            ok, frame = cap.read()
            if not ok:
                break
            now = time.time()

            # ===== 키 입력(강의 활성 토글 등) =====
            key = cv2.waitKey(1) & 0xFF
            if key == 27:
                break
            if key in (ord('l'), ord('L')):
                lecture_active = not lecture_active
                ding()
                conscious_notice_until = now + 2.0  # 2초만 표시

            # ===== vision =====
            rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            res = fm.process(rgb)

            if res.multi_face_landmarks:
                lm = res.multi_face_landmarks[0].landmark
                h, w = frame.shape[:2]
                def xy(i): return (lm[i].x * w, lm[i].y * h)

                left = {"outer": xy(33), "inner": xy(133), "top": xy(159), "bottom": xy(145)}
                right = {"outer": xy(362), "inner": xy(263), "top": xy(386), "bottom": xy(374)}
                ear = (ear_for_eye(left) + ear_for_eye(right)) / 2.0
                eyes_closed = 1 if ear < EAR_THRESH else 0

                mar = mouth_open_ratio(lm, w, h)
                mouth_open = 1 if mar > MAR_THRESH else 0

                gx, gy = gaze_xy(lm, w, h)
                yaw, roll, pitch = head_pose(lm, w, h)

                vis_buf.append((now, {
                    "GazeX": gx, "GazeY": gy,
                    "HeadYaw": yaw, "HeadRoll": roll, "HeadPitch": pitch,
                    "EyesClosed": eyes_closed,
                    "MouthOpen": mouth_open,
                    "MAR": float(mar),
                }))
                vis_buf30.append((now, eyes_closed, mouth_open, gx, gy, pitch))

            # prune buffers
            while vis_buf and vis_buf[0][0] < now - WIN_SEC:
                vis_buf.popleft()
            while vis_buf30 and vis_buf30[0][0] < now - LONG_SEC:
                vis_buf30.popleft()

            # ===== 5초마다 feature 업데이트 + 이벤트 판정 =====
            if now - last_tick >= WIN_SEC:
                last_tick = now

                task_input, input_event, scroll_cnt = agg.metrics()

                # 5초 통계: 평균 + 지속(비율) + 피크(p95)
                def mean_k(k):
                    return float(np.mean([v[k] for _, v in vis_buf])) if vis_buf else 0.0

                eyes_closed_ratio = float(np.mean([v["EyesClosed"] for _, v in vis_buf])) if vis_buf else 0.0
                eyes_open_ratio = 1.0 - eyes_closed_ratio

                mouth_open_ratio_5s = float(np.mean([v["MouthOpen"] for _, v in vis_buf])) if vis_buf else 0.0
                mar_p95 = float(np.percentile([v["MAR"] for _, v in vis_buf], 95)) if vis_buf else 0.0

                # gaze offscreen-ish: 시선이 중앙에서 많이 벗어난 비율(데모용 근사)
                gaze_off_ratio = float(np.mean([
                    1.0 if (abs(v["GazeX"]) > 0.55 or abs(v["GazeY"]) > 0.55) else 0.0
                    for _, v in vis_buf
                ])) if vis_buf else 0.0

                # 꾸벅: pitch가 갑자기 커지는 건 사람마다 달라서 데모에선 "큰 변화" 대신 단순 절대값 활용
                pitch_mean = mean_k("HeadPitch")
                pitch_p95 = float(np.percentile([v["HeadPitch"] for _, v in vis_buf], 95)) if vis_buf else 0.0

                latest_features = {
                    "GazeX": mean_k("GazeX"),
                    "GazeY": mean_k("GazeY"),
                    "GazeOffRatio": gaze_off_ratio,
                    "HeadPitch(mean)": pitch_mean,
                    "HeadPitch(p95)": pitch_p95,
                    "EyesOpen": eyes_open_ratio,
                    "EyesClosedRatio": eyes_closed_ratio,
                    "MouthOpen": mouth_open_ratio_5s,
                    "MAR(p95)": mar_p95,
                    "TaskInput": task_input,
                    "InputEvent": input_event,
                    "ScrollCnt": scroll_cnt,
                    "LectureActive": 1 if lecture_active else 0,
                }

                # ==========================
                # 의식 이탈(강의 최소화/딴짓) 감지
                # ==========================
                conscious_drift = (
                    (not lecture_active) or
                    (task_input <= CONSCIOUS_TASK_LOW and scroll_cnt <= CONSCIOUS_SCROLL_LOW and gaze_off_ratio >= CONSCIOUS_GAZE_OFF_RATIO)
                )

                if conscious_drift:
                    conscious_event_windows += 1
                    if conscious_event_windows >= CONSCIOUS_NEED_WINDOWS:
                        conscious_notice_until = now + 2.0
                        ding()
                        # 너무 계속 울리면 짜증나서, 한 번 울리면 카운트 리셋(데모 안정)
                        conscious_event_windows = 0
                else:
                    conscious_event_windows = 0

                # ==========================
                # 무의식 이탈(피로) 이벤트 감지 (규칙 기반)
                # - 나중에 CNN 붙이면 여기 한 줄만 교체
                # ==========================
                # 규칙 기반 (지금)
                unconscious_event = (
                    (eyes_closed_ratio >= 0.30) or
                    (mouth_open_ratio_5s >= 0.20) or
                    (mar_p95 >= MAR_THRESH + 0.10) or
                    (pitch_p95 >= pitch_mean + 8.0)  # 아주 러프한 꾸벅 근사
                )

                # ===== CNN 붙일 때는 이 한 줄로 교체 가능 =====
                # unconscious_event = (cnn_p_unconscious > 0.6)

                if unconscious_event:
                    unconscious_event_count += 1

                # 팝업 트리거
                can_intervene = (now - last_intervention_time) >= INTERVENTION_COOLDOWN_SEC
                popup_not_showing = (current_reco is None)

                if unconscious_event_count >= UNCON_EVENT_TRIGGER_N and can_intervene and popup_not_showing:
                    current_reco = random.sample(FATIGUE_PLANS_9, k=3)
                    last_intervention_time = now
                    unconscious_event_count = 0
                    ding()

            # ===== UI Draw =====
            # 상단 상태 텍스트
            if current_reco is not None:
                state_text = "STATE: UNCONSCIOUS (Plan Popup)"
            elif now <= conscious_notice_until:
                state_text = "STATE: CONSCIOUS DRIFT (Lecture off / distraction)"
            else:
                state_text = "STATE: FOCUS (Monitoring)"

            draw_topbar(frame, state_text)

            # 디버그/쿨다운
            cooldown_left = max(0.0, INTERVENTION_COOLDOWN_SEC - (now - last_intervention_time))
            draw_debug_panel(frame, unconscious_event_count, cooldown_left, conscious_event_windows, lecture_active)

            # 의식 이탈 배너(약하게)
            if now <= conscious_notice_until and current_reco is None:
                draw_small_notice(frame, "의식 이탈 감지: 강의 화면 이탈/딴짓 의심 (띵동)")

            # 하단 feature panel(원래처럼 점수 보여주기)
            draw_features_panel(frame, latest_features)

            # 선택 배너 먼저
            if selected_plan_msg is not None and now <= selected_plan_until:
                frame = draw_selected_banner(frame, selected_plan_msg)
            elif selected_plan_msg is not None and now > selected_plan_until:
                selected_plan_msg = None

            # 팝업은 제일 마지막
            if current_reco is not None:
                draw_intervention_popup(frame, current_reco)

            # 실시간 값 표시(맨 아래)
            dbg = ""
            if latest_features is not None:
                dbg = f"ear_thr={EAR_THRESH:.2f} mar_thr={MAR_THRESH:.2f} | EyesClosedRatio={latest_features['EyesClosedRatio']:.2f} MouthOpen={latest_features['MouthOpen']:.2f} Task={latest_features['TaskInput']} Scroll={latest_features['ScrollCnt']}"
            cv2.putText(frame, dbg, (20, frame.shape[0]-18),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255,255,255), 2, cv2.LINE_AA)

            cv2.imshow(WINDOW_NAME, frame)

            # ===== 선택 처리(팝업 떠 있을 때만) =====
            if current_reco is not None:
                if key in (ord('1'), ord('2'), ord('3')):
                    idx = key - ord('1')
                    if 0 <= idx < len(current_reco):
                        chosen = current_reco[idx]
                        selected_plan_msg = f"선택한 계획: {chosen}"
                        selected_plan_until = now + SELECT_BANNER_SEC
                        current_reco = None  # 선택했으니 팝업 닫기

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
