def overlay_png_fullscreen(base_bgr, overlay_png):
    """
    base_bgr: 웹캠 프레임 (BGR)
    overlay_png: 3.png (BGRA, 알파 포함)
    """
    h, w = base_bgr.shape[:2]

    ov = overlay_png
    if ov.shape[0] != h or ov.shape[1] != w:
        ov = cv2.resize(ov, (w, h), interpolation=cv2.INTER_AREA)

    # 알파 채널 없는 경우: 그냥 덮기
    if ov.shape[2] < 4:
        return ov[:, :, :3]

    b, g, r, a = cv2.split(ov)
    alpha = a.astype(np.float32) / 255.0
    alpha = cv2.merge([alpha, alpha, alpha])

    ov_bgr = cv2.merge([b, g, r]).astype(np.float32)
    base   = base_bgr.astype(np.float32)

    out = base * (1.0 - alpha) + ov_bgr * alpha
    return out.astype(np.uint8)
