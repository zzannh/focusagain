def load_char(name, w=120):
    path = os.path.join(BASE_DIR, name)

    # 🔥 Windows + 한글 경로 대응 (cv2.imread 대체)
    data = np.fromfile(path, dtype=np.uint8)
    img = cv2.imdecode(data, cv2.IMREAD_UNCHANGED)

    if img is None:
        raise RuntimeError(f"Character image not found: {path}")

    h0, w0 = img.shape[:2]
    scale = w / w0
    return cv2.resize(img, (int(w0 * scale), int(h0 * scale)))


def compose_with_bg(cam_bgr, bg_img, roi_rel=(0.035, 0.10, 0.965, 0.83)):
    """
    cam_bgr: 웹캠 프레임 (BGR)
    bg_img : 3.png 배경
    roi_rel: (x0, y0, x1, y1) 비율 좌표
    """
    H, W = cam_bgr.shape[:2]

    # 배경을 현재 프레임 크기로 맞춤
    bg = bg_img
    if bg.shape[1] != W or bg.shape[0] != H:
        bg = cv2.resize(bg, (W, H), interpolation=cv2.INTER_AREA)

    # BGRA → BGR
    if bg.shape[2] == 4:
        bg_bgr = bg[:, :, :3].copy()
    else:
        bg_bgr = bg.copy()

    # ROI 계산
    x0 = int(W * roi_rel[0])
    y0 = int(H * roi_rel[1])
    x1 = int(W * roi_rel[2])
    y1 = int(H * roi_rel[3])

    roi_w = x1 - x0
    roi_h = y1 - y0

    cam_resized = cv2.resize(cam_bgr, (roi_w, roi_h), interpolation=cv2.INTER_AREA)
    bg_bgr[y0:y1, x0:x1] = cam_resized

    return bg_bgr


